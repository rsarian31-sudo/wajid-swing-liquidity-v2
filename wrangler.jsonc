{
  "name": "wajid-swing-liquidity-v2",
  "main": "./worker.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRADE_STATE",
        "class_name": "WajidTradeState"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wajid-members",
      "database_id": "41805925-b66c-4f06-a7be-6a72e90f3ddf"
    }
  ],
  "exports": {
    "WajidTradeState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
