{
  "name": "wajid-swing-liquidity-v2",
  "main": "./worker.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRADE_STATE",
        "class_name": "WajidTradeState"
      }
    ]
  },
  "exports": {
    "WajidTradeState": {
      "type": "sqlite"
    }
  }
}
